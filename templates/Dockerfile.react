# React SPA (Vite or CRA), built then served as static files via nginx.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
# Vite outputs to /app/dist, CRA outputs to /app/build -- adjust as needed.
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

ENV PORT=8080
EXPOSE 8080
CMD sh -c "sed -i 's/listen 80;/listen $PORT;/' /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"
