# Angular SPA, built then served as static files via nginx.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build -- --configuration production

FROM nginx:alpine
# Adjust the dist path below to match your angular.json outputPath.
COPY --from=build /app/dist/*/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

ENV PORT=8080
EXPOSE 8080
CMD sh -c "sed -i 's/listen 80;/listen $PORT;/' /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"
